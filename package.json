{
  "name": "statistics-extended-graph",
  "version": "0.6.2",
  "description": "Statistics Extended Graph for Home Assistant - a customizable statistics chart card for Lovelace",
  "type": "module",
  "main": "dist/statistics-extended-graph.js",
  "module": "dist/statistics-extended-graph.js",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
