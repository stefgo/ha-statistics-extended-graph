# Copy to .env and adjust. .env is git-ignored.

# SSH target of the Home Assistant instance (user@host)
SEG_HOST=root@homeassistant.local

# SSH port (optional, default 22)
#SEG_SSH_PORT=22

# Home Assistant config directory on the instance (optional, default /config)
#SEG_CONFIG=/config

# Full target directory for the card (optional,
# default ${SEG_CONFIG}/www/community/ha-statistics-extended-graph)
#SEG_TARGET=/config/www/community/ha-statistics-extended-graph
