# Copy to .env and adjust. .env is git-ignored.

# SSH target of the Home Assistant instance (user@host)
CUSTOMGRAPH_HOST=root@homeassistant.local

# SSH port (optional, default 22)
#CUSTOMGRAPH_SSH_PORT=22

# Home Assistant config directory on the instance (optional, default /config)
#CUSTOMGRAPH_CONFIG=/config

# Full target directory for the card (optional,
# default ${CUSTOMGRAPH_CONFIG}/www/community/custom-graph)
#CUSTOMGRAPH_TARGET=/config/www/community/custom-graph
